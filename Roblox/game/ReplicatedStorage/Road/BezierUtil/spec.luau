--!strict
return function()
	local BezierUtil = require(script.Parent)

	local A = Vector3.new(0, 0, 0)
	local B = Vector3.new(0, 0, 10)
	local C = Vector3.new(0, 0, 20)
	local D = Vector3.new(0, 0, 30)

	describe("point", function()
		it("returns the endpoints at t=0 and t=1", function()
			expect((BezierUtil.point(A, B, C, D, 0) - A).Magnitude).to.be.near(0)
			expect((BezierUtil.point(A, B, C, D, 1) - D).Magnitude).to.be.near(0)
		end)

		it("stays on a straight line for colinear controls", function()
			local mid = BezierUtil.point(A, B, C, D, 0.5)
			expect(mid.X).to.be.near(0)
			expect(mid.Z).to.be.near(15)
		end)
	end)

	describe("length", function()
		it("matches the straight-line distance for a straight curve", function()
			local len = BezierUtil.length(A, B, C, D, 32)
			expect(len).to.be.near(30, 0.1)
		end)
	end)

	describe("isFiniteVector", function()
		it("accepts a normal vector", function()
			expect(BezierUtil.isFiniteVector(Vector3.new(1, 2, 3))).to.equal(true)
		end)
		it("rejects NaN and infinity", function()
			expect(BezierUtil.isFiniteVector(Vector3.new(0 / 0, 0, 0))).to.equal(false)
			expect(BezierUtil.isFiniteVector(Vector3.new(math.huge, 0, 0))).to.equal(false)
		end)
	end)

	describe("selfIntersects", function()
		it("is false for a straight curve", function()
			expect(BezierUtil.selfIntersects(A, B, C, D, 24)).to.equal(false)
		end)
		it("is false for a gentle S-curve", function()
			local s = Vector3.new(0, 0, 0)
			local h1 = Vector3.new(20, 0, 10)
			local h2 = Vector3.new(-20, 0, 20)
			local e = Vector3.new(0, 0, 30)
			expect(BezierUtil.selfIntersects(s, h1, h2, e, 32)).to.equal(false)
		end)
		it("is true for a looping curve that crosses itself", function()
			-- Handles thrown across each other so the cubic doubles back through itself.
			local s = Vector3.new(0, 0, 0)
			local h1 = Vector3.new(40, 0, 30)
			local h2 = Vector3.new(-30, 0, 30)
			local e = Vector3.new(10, 0, 0)
			expect(BezierUtil.selfIntersects(s, h1, h2, e, 40)).to.equal(true)
		end)
	end)

end
