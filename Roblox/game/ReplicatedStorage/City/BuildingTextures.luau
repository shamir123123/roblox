--!strict
-- BuildingTextures
-- Procedural building surface textures, generated by textures/TextureMaker.java
-- (terminal Java2D renderer) and uploaded as Roblox image assets. Moved here out of
-- RoadConstants -- these are building constants, not road constants.
--
-- Walls/roofs TILE (applied as a Texture with StudsPerTile); each WALL entry carries
-- its own tile size (studs) so brick repeats fine while stucco/stone tile coarser.
-- Doors/windows are full-face decals. See memory: transpot-residential-textures.

local BuildingTextures = {
	WALL = table.freeze({
		table.freeze({ id = "rbxassetid://120744987669991", tile = 3.2 }), -- red brick
		table.freeze({ id = "rbxassetid://117407076760406", tile = 3.2 }), -- brown brick
		table.freeze({ id = "rbxassetid://135144302293588", tile = 10 }),  -- cream stucco
		table.freeze({ id = "rbxassetid://93832687503532",  tile = 10 }),  -- white stucco
		table.freeze({ id = "rbxassetid://83368324469561",  tile = 5 }),   -- sage clapboard
		table.freeze({ id = "rbxassetid://75491684931289",  tile = 5 }),   -- blue-grey clapboard
		table.freeze({ id = "rbxassetid://89066648566749",  tile = 6 }),   -- ashlar stone
	}),
	-- Roof coverings. 2-5 were regenerated 2026-08 by texture-tools/gen_roofs.py at real US
	-- course geometry: ROOF_STUDS_PER_TILE = 6 spans about 80 real inches at this library's
	-- scale, so asphalt runs 16 courses (5in exposure), shake/slate 8 (10in), and standing
	-- seam 8 pans. Each tile is verified seamless by a PHASE-MATCHED check -- the wrap edge
	-- is compared against the other course lines, not against the mean interior delta, since
	-- the wrap legitimately lands on a butt shadow.
	--
	-- INDICES 1-5 ARE LOAD-BEARING: CommercialBuilder pins ROOF[3] and IndustrialBuilder
	-- pins ROOF[5], and ResidentialBuilder's MATERIALS table indexes this list by number.
	-- Entries 2-5 were replaced IN PLACE with the same material, so those callers keep their
	-- meaning and simply get a better image. New coverings are appended from 6.
	ROOF = table.freeze({
		"rbxassetid://133963365118092", -- 1 terracotta clay barrel tile (Spanish/Southwest only)
		"rbxassetid://91229757761841",  -- 2 grey slate
		"rbxassetid://81719491786801",  -- 3 charcoal 3-tab asphalt
		"rbxassetid://80655094874245",  -- 4 brown architectural asphalt
		"rbxassetid://134882649734312", -- 5 standing-seam metal, galvanised grey
		"rbxassetid://118187037702844", -- 6 weathered-wood 3-tab asphalt
		"rbxassetid://138103580452534", -- 7 charcoal architectural asphalt
		"rbxassetid://108889485545973", -- 8 cedar shake
		"rbxassetid://126034574124259", -- 9 standing-seam metal, forest green
	}),
	-- The SAME nine coverings, pre-rotated 90 degrees, index-for-index with ROOF.
	--
	-- Roblox `Texture` has no rotation property (a documented engine limitation), and a face's
	-- U axis follows the PART's local X. A CornerWedgePart hip corner is yawed 0/90/180/270,
	-- so its shingle courses come out rotated a quarter turn on half the corners and the roof
	-- reads as patchwork. Picking the pre-rotated image for the yawed ones is the only way to
	-- make the courses agree. rot90 of a seamless square tile is still seamless.
	ROOF_ROT90 = table.freeze({
		"rbxassetid://133963365118092", -- 1 barrel (unrotated: unused on residential)
		"rbxassetid://122692427835519", -- 2 grey slate
		"rbxassetid://80201445885173",  -- 3 charcoal 3-tab
		"rbxassetid://118604881164783", -- 4 brown architectural
		"rbxassetid://98596502335307",  -- 5 metal grey
		"rbxassetid://131301315151643", -- 6 weathered 3-tab
		"rbxassetid://86660086666452",  -- 7 charcoal architectural
		"rbxassetid://93499605645763",  -- 8 cedar shake
		"rbxassetid://115347005015592", -- 9 metal green
	}),
	-- Residential doors and windows, regenerated 2026-08 by texture-tools/gen_openings.py
	-- (procedural Python, seeded and re-rollable -- not AI art). Consumed ONLY by
	-- ServerStorage.Authoring.ResidentialBuilder; the commercial/industrial/transit builders
	-- use WINDOW_SINGLE / WINDOW_COMMERCIAL / WINDOW_INDUSTRIAL and are unaffected.
	--
	-- Every one of these has an UNLIT BLACK interior and no specular streak. A glare
	-- highlight is baked for one sun angle, so on a street whose houses face four different
	-- ways most of them end up lit wrongly; a dark interior is correct at every orientation.
	DOOR_FRONT = table.freeze({
		"rbxassetid://115448440088488", -- 6-panel, white
		"rbxassetid://127081995548976", -- 6-panel, navy
		"rbxassetid://140486707540331", -- 6-panel, red
		"rbxassetid://123550372601516", -- 4-panel, forest green
		"rbxassetid://87969233630106",  -- 6-lite over 2 panels, white
		"rbxassetid://83103278825542",  -- 6-lite over 2 panels, black
	}),
	DOOR_BACK = table.freeze({
		"rbxassetid://115448440088488", -- 6-panel, white
		"rbxassetid://123550372601516", -- 4-panel, forest green
		"rbxassetid://87969233630106",  -- 6-lite over 2 panels, white
	}),
	WINDOW = table.freeze({
		"rbxassetid://106570132876883", -- double-hung, 6-over-6
		"rbxassetid://136464678688625", -- double-hung, 2-over-2
		"rbxassetid://122869330056044", -- double-hung, unmuntined picture sash
	}),
	-- Commercial / industrial wall skins (tiling), generated by textures/building_textures.py.
	WALL_COMMERCIAL = table.freeze({
		table.freeze({ id = "rbxassetid://105733054917849", tile = 3.2 }), -- white painted brick
		table.freeze({ id = "rbxassetid://137700066331586", tile = 3.2 }), -- grey painted brick
		table.freeze({ id = "rbxassetid://139755538118847", tile = 12 }),  -- concrete tilt-up panel
		table.freeze({ id = "rbxassetid://100372063385258", tile = 6 }),   -- cinderblock
	}),
	WALL_INDUSTRIAL = table.freeze({
		table.freeze({ id = "rbxassetid://71799249722464",  tile = 8 }),   -- corrugated metal, galvanised grey
		table.freeze({ id = "rbxassetid://110975596306825", tile = 8 }),   -- corrugated metal, blue
		table.freeze({ id = "rbxassetid://111729270731613", tile = 8 }),   -- corrugated metal, sage
		table.freeze({ id = "rbxassetid://139755538118847", tile = 12 }),  -- concrete tilt-up panel
		table.freeze({ id = "rbxassetid://100372063385258", tile = 6 }),   -- cinderblock
	}),
	-- Full-face window decals (transparent margin blends into the wall colour).
	WINDOW_INDUSTRIAL = "rbxassetid://88615730471592",  -- steel 6x4 factory grid
	WINDOW_COMMERCIAL = "rbxassetid://108157351474268", -- aluminium 2-lite + transom
	ROOF_STUDS_PER_TILE = 6,
	-- Legacy flat curtain-wall window decal still used by the Commercial / Transit builders.
	WINDOW_SINGLE = "rbxassetid://124262132655132",
}

return table.freeze(BuildingTextures)
