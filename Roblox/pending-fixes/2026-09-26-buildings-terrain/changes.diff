+local function forCells(x0: number, x1: number, z0: number, z1: number, fn: (number) -> ())
+	for cz = math.floor(z0 / CELL), math.floor(z1 / CELL) do
+		for cx = math.floor(x0 / CELL), math.floor(x1 / CELL) do
+			fn(cz * 65536 + cx)
+		end
+	end
+end
