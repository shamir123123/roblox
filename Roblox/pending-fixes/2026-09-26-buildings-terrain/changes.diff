+local function padBounds(rec: PadRec, grow: number): (number, number, number, number)
+	local r = math.sqrt(rec.w * rec.w + rec.d * rec.d) * 0.5 + grow
+	return rec.px - r, rec.px + r, rec.pz - r, rec.pz + r
+end
